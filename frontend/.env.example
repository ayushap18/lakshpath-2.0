# =============================================
# LakshPath Frontend — Environment Variables
# =============================================

# Backend API URL
# Dev: http://localhost:5001/api (proxied via Vite, so this is only used in prod builds)
# Prod: https://your-backend-domain.com/api OR /api if same-origin
VITE_API_BASE_URL=http://localhost:5001/api

# Google OAuth Client ID (same as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Razorpay Key ID (public key — safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=
