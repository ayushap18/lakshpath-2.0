# ====================================
# LakshPath Production Environment
# ====================================

# Server
NODE_ENV=production
PORT=8080

# Database (Google Cloud SQL or Neon PostgreSQL)
# For Neon (free): Sign up at https://neon.tech, create a project, copy the connection string
# For Cloud SQL: Use the connection string from Google Cloud Console
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lakshpath?sslmode=require"

# Google Gemini AI
# IMPORTANT: Enable billing in Google Cloud Console to use your $20 credit
# Go to: https://aistudio.google.com/apikey → click project → enable billing
GEMINI_API_KEY="AIzaSyAhJW27ns7qR0uFQKCdt9S3sh3phcb7QJI"
GEMINI_MODEL="gemini-2.0-flash"

# Google OAuth
GOOGLE_CLIENT_ID="1043557580500-e23jr5msn9g4an47rh2norr5g7lf42j9.apps.googleusercontent.com"

# JWT (CHANGE THIS for production!)
JWT_SECRET="lakshpath-prod-secret-change-this-to-random-string"

# CORS - Set to your production URL
CLIENT_ORIGIN="*"
FRONTEND_URL="https://YOUR_CLOUD_RUN_URL"

# Demo mode
DEMO_MODE_ENABLED=true
