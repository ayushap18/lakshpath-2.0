# Git
.git
.gitignore

# Dependencies (rebuilt in Docker)
node_modules
backend/node_modules
frontend/node_modules

# Build outputs (rebuilt in Docker)
dist
backend/dist
frontend/dist

# Environment files (secrets — set via Cloud Run env vars)
.env
.env.local
backend/.env
frontend/.env

# Root .env.production is a template — keep excluded
/.env.production
# NOTE: frontend/.env.production is NOT excluded — it holds public
# build-time values (VITE_GOOGLE_CLIENT_ID, VITE_API_BASE_URL) that
# are exposed in the browser bundle anyway.

# Dev files
*.md
docs
scripts
test-*.sh
*.log
.vscode
.idea

# SQLite dev database
backend/prisma/dev.db
backend/prisma/dev.db-journal
