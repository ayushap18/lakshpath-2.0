# =============================================
# LakshPath Backend — Environment Variables
# =============================================

# Server
NODE_ENV=development
PORT=5001

# Database (PostgreSQL)
# Dev: Use local PostgreSQL or Neon free tier (https://neon.tech)
# Prod: Use managed PostgreSQL with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lakshpath"

# Google Gemini AI
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Add authorized origins: http://localhost:3000 (dev), https://yourdomain.com (prod)
# Add authorized redirect URIs: http://localhost:3000 (dev), https://yourdomain.com (prod)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT Authentication
# Dev: default is fine. Prod: generate with `openssl rand -hex 32`
JWT_SECRET="lakshpath-dev-secret"

# CORS — comma-separated allowed origins
# Dev: localhost ports. Prod: your frontend domain ONLY
CLIENT_ORIGIN="http://localhost:3000,http://localhost:5173"
FRONTEND_URL="http://localhost:3000"

# Demo mode — set false in production
DEMO_MODE_ENABLED=false

# Razorpay Billing (required for Pro subscriptions)
# Get keys at: https://dashboard.razorpay.com/app/keys
# Create a monthly plan in Razorpay Dashboard > Subscriptions > Plans
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_PRO=""

# GitHub token (optional — higher API rate limits for portfolio analysis)
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=""

# ElevenLabs TTS (optional)
ELEVENLABS_API_KEY=""

# Email / SMTP (optional — for password reset emails)
EMAIL_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@lakshpath.ai"
SMTP_SECURE=false

# Password hashing rounds
BCRYPT_ROUNDS=12
